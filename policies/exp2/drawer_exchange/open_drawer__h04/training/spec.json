    "conversion_check": {
      "description": "For a valid demonstration label, active-frame encoding followed by decoding against the same pre-action observation reconstructs the demonstrated commanded world TCP pose. The framework checks FK position in metres, rotation angle in radians and unchanged gripper scalar; nonunique IK is allowed. Gram-Schmidt only projects sampled non-orthogonal 6D rotations.",
      "mode": "task_space",
      "tolerance": 0.01
    },
    "cut_relation": "Covers every assigned action in each [0,470) segment. It retains high approach, drawer-front acquisition and pull, release and retreat, red approach/closure and initial lift, including all 240 action-supervised steps 230:470 overlapping red_transfer in every demonstration.",
    "input_shapes": {
      "features": [
        2,
        49
