{
  "type": "object",
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "subgoal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "segmentation_rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trajectory_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "stop": {
                  "type": "integer",
                  "minimum": 1
                },
                "occurrence_context": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "trajectory_id",
                "start",
                "stop",
                "occurrence_context"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 256
          },
          "handoff": {
            "type": "object",
            "properties": {
              "entry_conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "exit_conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "overlap_role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "successor_readiness": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "failure_signatures": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              }
            },
            "required": [
              "entry_conditions",
              "exit_conditions",
              "overlap_role",
              "successor_readiness",
              "failure_signatures"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trajectory_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                },
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "maxItems": 24
                }
              },
              "required": [
                "trajectory_id",
                "indices"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          }
        },
        "required": [
          "skill_id",
          "name",
          "subgoal",
          "segmentation_rationale",
          "segments",
          "handoff",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trajectory_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "stop": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          }
        },
        "required": [
          "trajectory_id",
          "start",
          "stop",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "overlap_rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    }
  },
  "required": [
    "skills",
    "exclusions",
    "overlap_rationale"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill datasets and handoffs"
}
