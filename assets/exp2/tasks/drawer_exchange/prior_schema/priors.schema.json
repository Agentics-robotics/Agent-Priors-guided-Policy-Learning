{
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "cut_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "priors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "trajectory_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12000,
                  "pattern": "\\S"
                },
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "maxItems": 24
                }
              },
              "required": [
                "trajectory_id",
                "indices"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "applicability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "pipeline_implications": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "handoff": {
            "type": "object",
            "properties": {
              "entry_conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "exit_conditions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "overlap_role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "successor_readiness": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              },
              "failure_signatures": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12000,
                "pattern": "\\S"
              }
            },
            "required": [
              "entry_conditions",
              "exit_conditions",
              "overlap_role",
              "successor_readiness",
              "failure_signatures"
            ],
            "additionalProperties": false
          },
          "invocation_contract": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60000
          },
          "training_bindings": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60000
          }
        },
        "required": [
          "statement",
          "evidence",
          "rationale",
          "applicability",
          "pipeline_implications",
          "limitations",
          "handoff",
          "invocation_contract",
          "training_bindings"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "skill_id",
    "cut_plan_sha256",
    "priors"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent prior policies for an assigned skill"
}
